{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["vite.config.ts", "vite.wrapper.config.ts", "vite.static.config.ts", "vite.custom-runtime.config.ts", "vitest.custom-page.config.ts", "scripts/custom-page/**/*.ts", "scripts/chinaums-open-demo/**/*.ts"]
}
