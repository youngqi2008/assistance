{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-bff",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["bff/src/**/*.ts"],
  "exclude": ["bff/src/**/*.test.ts"]
}
