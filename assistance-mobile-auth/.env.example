# Phase 3/9 JSSDK defaults keep local mock-mode explicit.
# Mobile JSSDK appkey is embedded in frontend source by the current integration decision.
# Do not place unrelated private keys or raw auth results in this file.
VITE_MOBILE_AUTH_SDK_ENABLED=false
VITE_MOBILE_AUTH_SDK_MODE=mock
VITE_MOBILE_AUTH_SDK_CSS_URL=
VITE_MOBILE_AUTH_DEBUG_ENTRY=false
VITE_MOBILE_AUTH_VERSION=
VITE_MOBILE_AUTH_APP_ID=
VITE_MOBILE_AUTH_SIGN=
VITE_MOBILE_AUTH_TRACE_ID=
VITE_MOBILE_AUTH_TIMESTAMP=
VITE_MOBILE_AUTH_AUTH_TYPE=
VITE_MOBILE_AUTH_SCOPE=
# Build classification used only for dev/debug page visibility.
# It never changes the fixed official JSSDK 1.0.6 resource or authType policy.
VITE_MOBILE_AUTH_ENV=prod
VITE_MOBILE_ASSISTANT_API_BASE=/sign-pay-pro/api/mobile-assistant
VITE_SFT_SDK_SESSION_API_BASE=/sign-pay-pro/api/sdk/session

# Test host only. These are SFT customer-session credentials, not the Mobile JSSDK appkey.
# The Mobile JSSDK appkey is intentionally embedded in frontend source.
VITE_SFT_CUSTOMER_APP_ID=10037e6f9512b0b10195401ca57901d1
VITE_SFT_CUSTOMER_APP_KEY=

# Temporary only while the Mobile JSSDK appId/auth token is not available.
# The H5 page can use this token to exercise the BFF verify/query path after
# the user enters the ID-card last four digits.
VITE_MOBILE_ASSISTANT_TEST_TOKEN=

# NestJS BFF / local dev-server only. Never expose these as VITE_* variables.
BFF_PORT=12588
BFF_API_PREFIX=/sign-pay-pro/api
BFF_STATIC_ROOT=dist
BFF_STATIC_BASE=/sign-pay-pro
CHINAUMS_ASSISTANT_APP_ID=
CHINAUMS_ASSISTANT_APP_KEY=
CHINAUMS_ASSISTANT_PRIVATE_KEY=
CHINAUMS_ASSISTANT_PLATFORM_PUBLIC_KEY=
CHINAUMS_ASSISTANT_CHECK_URL=https://test-api-open.chinaums.com/v1/datacenter/smartverification/encrypted/assistant/info/check
CHINAUMS_ASSISTANT_QUERY_URL=https://test-api-open.chinaums.com/v1/datacenter/smartverification/encrypted/assistant/info/query
CHINAUMS_ASSISTANT_USER_NO=08
CHINAUMS_ASSISTANT_REQUEST_ID=
CHINAUMS_ASSISTANT_KEY_A=
SFT_CUSTOMER_APP_ID=
SFT_CUSTOMER_APP_KEY=
MOBILE_AUTH_APP_ID=300013215094
