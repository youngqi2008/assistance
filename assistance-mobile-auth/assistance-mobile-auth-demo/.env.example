# 我方 JSSDK 静态资源地址（ESM 包，供动态 import() 加载）
VITE_SDK_URL=https://ginkgo.chinaums.com/sign-pay-pro/assist/assistance-mobile-auth/assistance-mobile-auth.js

# 会话接口前缀（开发态走 vite 代理，见 vite.config.js）
VITE_SESSION_API_BASE=/sign-pay-pro/api/sdk/session

# 本地开发代理目标（我方测试环境）
VITE_API_PROXY_TARGET=https://ginkgo.chinaums.com

# 测试环境演示凭证；正式接入时必须保管在业务方服务端，严禁放前端
VITE_APP_ID=
VITE_APP_KEY=

# createSdk() 的客户接入 appId（0.2.0 起必传，与 BFF 发放同一体系，此处仅用于
# 授权页内容分流，未匹配到 profile 时展示默认页；与上面 VITE_APP_ID 语义不同）
VITE_SDK_APP_ID=demo-brand-001

# 我方托管授权页地址（H5 转跳目标）
VITE_AUTH_PAGE_URL=https://ginkgo.chinaums.com/sign-pay-pro/auth

# 可选：回跳地址；留空则运行时用当前站点 origin + /callback.html
VITE_REDIRECT_CALLBACK_URL=
