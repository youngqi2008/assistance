{
  "name": "mobile-auth-h5",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bff": "npm run build:bff && node dist-bff/bff/src/main.js",
    "start:bff": "node dist-bff/bff/src/main.js",
    "build": "npm run build:h5",
    "build:h5": "tsc -b && vite build && node scripts/flatten-layers.mjs dist/assets",
    "build:static-h5": "tsc -b && VITE_MOBILE_AUTH_ENV=prod vite build --config vite.static.config.ts && node scripts/flatten-layers.mjs dist-static/assets",
    "build:bff": "tsc -p tsconfig.bff.json",
    "build:wrapper": "tsc -b && vite build --config vite.wrapper.config.ts",
    "build:static-wrapper": "VITE_STATIC_RESOURCE_RELEASE=1 VITE_MOBILE_AUTH_ENV=prod vite build --config vite.wrapper.config.ts",
    "build:custom-loader": "vite build --config vite.custom-loader.config.ts",
    "build:custom-wrapper": "VITE_STATIC_RESOURCE_RELEASE=1 VITE_MOBILE_AUTH_ENV=prod vite build --config vite.wrapper.config.ts --outDir dist-custom-wrapper",
    "build:custom-temp": "node scripts/custom-page/build-custom-temp.mjs",
    "build:duodian-health": "node scripts/duodian-health/build.mjs",
    "build:duodian-health031": "node scripts/duodian-health/build.mjs --sdk-version 0.3.1",
    "build:duodian-health032": "node scripts/duodian-health/build.mjs --sdk-version 0.3.2",
    "release:static": "node scripts/static-release/release-static.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:bff": "vitest --run --config vitest.bff.config.ts",
    "test:wrapper": "vitest --run src/wrapper src/sdk",
    "test:phase6": "vitest --run src/pages src/sdk src/wrapper && npm run build:h5 && npm run build:wrapper",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsbn": "^1.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sm-crypto": "^0.4.0",
    "tailwind-merge": "^3.3.0",
    "vconsole": "3.15.1"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sm-crypto": "^0.3.4",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
