# 复制为 deploy/gateway.env 后填写。不要提交真实密钥。
# 目标机：62.234.150.103（前后端与 Nginx 都装在这台机器上）
# DNS：sdk.zgzytech.com 的 A 记录指向 62.234.150.103
# 云主机公网 IP 多为弹性 IP，Nginx 监听 0.0.0.0:443，不要 bind 到该公网 IP。
# Java 只监听 127.0.0.1:8080，由本机 Nginx 反代。

# ---------- 部署机 ----------
DEPLOY_HOST=62.234.150.103

# ---------- 对外 HTTPS（Nginx）----------
# 前后端同域：浏览器与客户后端都访问下面这个 origin
PUBLIC_HTTPS_ORIGIN=https://sdk.zgzytech.com
PUBLIC_BASE_PATH=/sign-pay-pro/
# 后端 API 对外地址；同域时与 PUBLIC_HTTPS_ORIGIN 相同
API_HTTPS_ORIGIN=https://sdk.zgzytech.com

# ---------- Java / Maven ----------
# JAVA_HOME=C:\Program Files\Java\jdk-17
SERVER_PORT=8080
# 测试：ums-test,edge    生产：ums-prod,edge    本机关鉴权：local,edge
SPRING_PROFILES_ACTIVE=ums-test,edge
JAR_NAME=zhongguan-assistant-gateway-0.1.0-SNAPSHOT.jar
# Linux 部署目录
APP_HOME=/app/home/zhongguan-assistant-gateway
# Windows 本机运行目录（相对仓库）
# APP_HOME 未设时 start 脚本使用网关工程目录

# ---------- 银商测试凭据 ----------
CHINAUMS_TEST_APP_ID=10037e6f9512b0b10195401ca57901d1
CHINAUMS_TEST_APP_KEY=0e609fbbdbde40e5aa467b235eb4c67e
CHINAUMS_TEST_PRIVATE_KEY=33c196da0c7e369025c01796e5dd11528740a7abef0f025309b9b6770367131f
CHINAUMS_TEST_USER_NO=08

# ---------- 银商生产凭据（ums-prod 才用）----------
CHINAUMS_PROD_APP_ID=
CHINAUMS_PROD_APP_KEY=
CHINAUMS_PROD_PRIVATE_KEY=

# ---------- 中冠管理 ----------
ZHONGUAN_ADMIN_TOKEN=
ZHONGUAN_CLIENTS_FILE=data/clients.json

# ---------- Nginx ----------
NGINX_BIN=nginx
NGINX_HOME=
NGINX_HTML=/var/www/assistant-h5
NGINX_CONF_NAME=assistant-https.conf
# 证书。生产用已签发给 sdk.zgzytech.com 的证书；联调自签见 deploy/nginx/gen-self-signed.sh
SSL_CERT=/etc/nginx/ssl/assistant.crt
SSL_KEY=/etc/nginx/ssl/assistant.key
# 本机自签时可改成仓库内路径，例如：
# SSL_CERT=/path/to/assistance/deploy/nginx/ssl/server.crt
# SSL_KEY=/path/to/assistance/deploy/nginx/ssl/server.key
SERVER_NAME=sdk.zgzytech.com
# 安全组放行 443。80 空闲且希望 http 自动跳 https 时改为 1。
# 80 已被 Docker 等占用时保持 0，只监听 443。
NGINX_LISTEN_HTTP=0
